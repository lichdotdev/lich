+func showJobScript(ctx context.Context, io *iostreams.IOStreams, client *gitlab.Client, projectID int64, content []byte, path, jobName string) error {
+	body := &struct {
+		Content     string `json:"content"`
+		IncludeJobs bool   `json:"include_jobs"`
+	}{
+		Content:     string(content),
+		IncludeJobs: true,
+	}
+
+	opts := []gitlab.RequestOptionFunc{
+		api.WithSafeRetries(),
+		gitlab.WithContext(ctx),
+	}
+
+	req, err := client.NewRequest(http.MethodPost, fmt.Sprintf("projects/%d/ci/lint", projectID), body, opts)
+	if err != nil {
+		return err
+	}
+
+	var result projectLintResultWithJobs
+	if _, err := client.Do(req, &result); err != nil {
+		return err
+	}
+
+	if !result.Valid {
+		errorsStr := strings.Join(result.Errors, ", ")
+		return fmt.Errorf("could not compile %s: %s", path, errorsStr)
+	}
+
+	available := make([]string, 0, len(result.Jobs))
+	for _, job := range result.Jobs {
+		if job.Name == jobName {
+			printJob(io, job)
+			return nil
+		}
+		available = append(available, job.Name)
+	}
+
+	return fmt.Errorf("job %q not found in CI/CD configuration. Available jobs: %s", jobName, strings.Join(available, ", "))
+}
+
+func printJob(io *iostreams.IOStreams, job lintJob) {
+	hasMainScript := len(job.BeforeScript) > 0 || len(job.Script) > 0
+
+	for _, line := range job.BeforeScript {
+		io.LogInfo(line)
+	}
+	for _, line := range job.Script {
+		io.LogInfo(line)
+	}
+
+	if len(job.AfterScript) > 0 {
+		if hasMainScript {
+			io.LogInfo()
+		}
+		io.LogInfo("# after_script")
+		for _, line := range job.AfterScript {
+			io.LogInfo(line)
+		}
+	}
+}
