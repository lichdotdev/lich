+func Test_compileRun_job(t *testing.T) {
+	// This test uses httptest.NewServer because fetching jobs uses raw HTTP
+	// via client.Do() rather than a GitLab client-go service interface.
+	t.Parallel()
+
+	tests := []struct {
+		name       string
+		args       string
+		wantStdOut string
+		wantErr    string
+		resp       projectLintResultWithJobs
+	}{
+		{
+			name:       "job with before_script, script, and after_script",
+			args:       "--job test-job",
+			wantStdOut: "echo setup\nnpm test\nnpm run lint\n\n# after_script\necho cleanup\n",
+			resp: projectLintResultWithJobs{
+				ProjectLintResult: gitlab.ProjectLintResult{Valid: true},
+				Jobs: []lintJob{
+					{Name: "test-job", BeforeScript: []string{"echo setup"}, Script: []string{"npm test", "npm run lint"}, AfterScript: []string{"echo cleanup"}},
+					{Name: "build-job", Script: []string{"npm run build"}},
+				},
+			},
+		},
+		{
+			name:       "job with only script",
+			args:       "--job build-job",
+			wantStdOut: "npm run build\n",
+			resp: projectLintResultWithJobs{
+				ProjectLintResult: gitlab.ProjectLintResult{Valid: true},
+				Jobs: []lintJob{
+					{Name: "test-job", Script: []string{"npm test"}},
+					{Name: "build-job", Script: []string{"npm run build"}},
+				},
+			},
+		},
+		{
+			name:    "job not found lists available jobs",
+			args:    "--job deploy-job",
+			wantErr: `job "deploy-job" not found in CI/CD configuration. Available jobs: test-job, build-job`,
+			resp: projectLintResultWithJobs{
+				ProjectLintResult: gitlab.ProjectLintResult{Valid: true},
+				Jobs: []lintJob{
+					{Name: "test-job", Script: []string{"npm test"}},
+					{Name: "build-job", Script: []string{"npm run build"}},
+				},
+			},
+		},
+		{
+			name:    "invalid CI configuration returns validation error",
+			args:    "--job test-job",
+			wantErr: "could not compile",
+			resp: projectLintResultWithJobs{
+				ProjectLintResult: gitlab.ProjectLintResult{
+					Valid:  false,
+					Errors: []string{"jobs:test-job config key may not be used with script"},
+				},
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			testServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch {
+				case r.Method == http.MethodGet && r.URL.Path == "/api/v4/projects/OWNER/REPO":
+					_, _ = w.Write([]byte(`{"id": 123, "path_with_namespace": "OWNER/REPO"}`))
+				case r.Method == http.MethodPost && r.URL.Path == "/api/v4/projects/123/ci/lint":
+					_ = json.NewEncoder(w).Encode(tt.resp)
+				default:
+					t.Errorf("unexpected request: %s %s", r.Method, r.URL.Path)
+					w.WriteHeader(http.StatusNotFound)
+				}
+			}))
+			defer testServer.Close()
+
+			gitlabClient, err := gitlab.NewClient("test-token", gitlab.WithBaseURL(testServer.URL+"/api/v4"))
+			require.NoError(t, err)
+
+			exec := cmdtest.SetupCmdForTest(t, NewCmdConfigCompile, false,
+				cmdtest.WithGitLabClient(gitlabClient),
+				cmdtest.WithBaseRepo("OWNER", "REPO", ""),
+			)
+
+			cliArgs := path.Join(cmdtest.ProjectPath, "test/testdata/.gitlab-ci.yml") + " " + tt.args
+			out, err := exec(cliArgs)
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				require.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.wantStdOut, out.OutBuf.String())
+		})
+	}
+}
